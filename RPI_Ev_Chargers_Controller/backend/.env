APP_NAME=EV Charger HMI
TELEMETRY_SOURCE=zmq

# Existing Shift2DC publisher binds tcp://*:3333.
ZMQ_ENDPOINT=tcp://127.0.0.1:3333
ZMQ_TOPIC=
ZMQ_MESSAGE_FORMAT=json

# Commands/setpoints are sent to run_zmq_server.py on a separate ZMQ REQ/REP channel.
COMMAND_PUBLISHER=zmq
ZMQ_COMMAND_ENDPOINT=tcp://127.0.0.1:3334
COMMAND_TIMEOUT_MS=1000

TELEMETRY_RATE_LIMIT_MS=250
HISTORY_SAMPLE_PERIOD_MS=1000
STALE_TIMEOUT_SECONDS=3
OFFLINE_TIMEOUT_SECONDS=10
SQLITE_PATH=data/hmi.sqlite3
LIVE_BUFFER_POINTS=1200

# Chargers shown by the HMI. If only N01 is physically connected, keep only N01.
CHARGER_IDS=N01, N02
ALLOW_UNKNOWN_CHARGERS=false
CHARGER_MAX_POWER_KW=11.04
CHARGER_POWER_LIMITS=N01=11.04,N02=11.04
PARAMETER_CONFIG_PATH=../config/charger_parameter_limits.json
