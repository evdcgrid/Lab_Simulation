# EV Charger HMI stack defaults.
#
# This file is read by systemd/ev-hmi-stack.service and scripts/run_hmi_stack.sh.
# It controls which local processes are started. Charger/CAN/backend defaults live
# in the files listed in HMI_DEFAULTS.md.

HMI_ROOT=/home/pi/Documents/Lab_Simulation/RPI_Ev_Chargers_Controller

# CAN/ZMQ publisher.
# Keep this aligned with backend/.env CHARGER_IDS.
HMI_NODES=N01,N02
HMI_STARTUP_SEQUENCE=1
HMI_COMMAND_SERVER=1
HMI_COMMAND_ENDPOINT=tcp://*:3334
HMI_FORWARD_DATA=0
HMI_CHARGE_CONFIRM_TIMEOUT_SECONDS=10

# FastAPI backend.
HMI_BACKEND_HOST=0.0.0.0
HMI_BACKEND_PORT=8000

# Frontend.
# "static" is optimized for the Pi: React is built once and served by FastAPI on port 8000.
# Use "dev" only while editing the frontend, with Vite on port 5173.
HMI_FRONTEND_MODE=static
HMI_FRONTEND_HOST=0.0.0.0
HMI_FRONTEND_PORT=5173

# Kiosk browser opened by the graphical desktop autostart.
HMI_KIOSK_URL=http://127.0.0.1:8000
HMI_KIOSK_BROWSER=/usr/bin/firefox
HMI_KIOSK_PROFILE=/home/pi/.mozilla/hmi-kiosk
HMI_KIOSK_WAIT_SECONDS=120
HMI_KIOSK_DISPLAY=:0

# Python environment used for both run_zmq_server.py and backend/uvicorn.
HMI_PYTHON=/home/pi/Documents/Lab_Simulation/RPI_Ev_Chargers_Controller/.venv/bin/python
HMI_UVICORN=/home/pi/Documents/Lab_Simulation/RPI_Ev_Chargers_Controller/.venv/bin/uvicorn
