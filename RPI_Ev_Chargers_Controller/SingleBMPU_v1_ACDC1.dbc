CM_ SG_ 384 DcdcOnFlag "Set to 1 if DCDC is ON";
CM_ SG_ 384 InputCurrentLimitationFlag "Set to 1 if PU is limited by input current";
CM_ SG_ 384 LoadImpedanceLimitationFlag "Set to 1 if PU is limited by output load impedance  ";
CM_ SG_ 384 ThermalLimitationFlag "Set to 1 if PU is limited by thermal heating";
CM_ SG_ 384 GridDetectionFlag "Set to 1 if Grid is detected";
CM_ SG_ 384 AggregatedPlusFalg "Set to 1 if it is a master Pu in charge of 1 or several distant (slave Pus)";
CM_ SG_ 384 itfc_critical_fault_word "Fault Word";
